{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": ["extension/**/*.js"],
  "exclude": [
    "extension/tests/**",
    "extension/background.js",
    "extension/offscreen.js",
    "extension/popup.js",
    "extension/content.js",
    "extension/reader.js",
    "extension/shared/*-umd.js"
  ]
}
