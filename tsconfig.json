{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "chrome"
    ],
    "skipLibCheck": true
  },
  "include": [
    "extension/**/*.js"
  ],
  "exclude": [
    "extension/tests/**",
    "extension/content/content.js"
  ]
}
