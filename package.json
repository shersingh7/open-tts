{
  "name": "open-tts",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run lint && npm run typecheck && npm run test:js && npm run test:backend",
    "test:js": "vitest run",
    "test:backend": "env -u PYTHONPATH backend/venv/bin/python -m pytest backend/tests -q",
    "test:extension": "vitest run extension/tests",
    "package:extension": "node scripts/package-extension.mjs",
    "test:model-matrix": "env -u PYTHONPATH backend/venv/bin/python scripts/model-matrix.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  }
}
